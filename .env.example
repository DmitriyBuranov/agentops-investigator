# Choose the LLM provider without changing application code.
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (only required when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna

# Local operational API
OPS_SERVICE_URL=http://localhost:8003

LAB_DOCS_PATH=../agent-incident-lab/docs